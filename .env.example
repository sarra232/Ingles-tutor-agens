# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE AMBIENTE — ORUS ENGLISH STUDIO
# ============================================================================
# Cómo configurar en un nuevo computador:
# 1. Copia este archivo y renómbralo como `.env` en la raíz del proyecto:
#      cp .env.example .env
# 2. Reemplaza el valor de GEMINI_API_KEY con tu clave de Google AI Studio
#    (obtenida gratis en https://aistudio.google.com/apikey)
# 3. Opcionalmente, en Windows PowerShell puedes registrarla como variable de
#    ambiente del usuario con:
#      [Environment]::SetEnvironmentVariable("GEMINI_API_KEY", "TU_CLAVE_AQUI", "User")
# ============================================================================

GEMINI_API_KEY=PEGA_AQUI_TU_CLAVE_DE_GOOGLE_AI_STUDIO

